<Window x:Class="ReplayBuffer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replay Buffer" Width="760" Height="900" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="app.ico"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- a group of setting rows -->
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,16,0" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Field" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <EventSetter Event="SelectionChanged" Handler="Video_Changed" />
        </Style>

        <!-- small borderless icon button (remove etc.) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 style on/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="State" Text="Off" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14" />
                            <Grid Width="40" Height="20">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="Transparent"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="State" Property="Text" Value="On" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1000">

            <!-- title -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,18">
                <Image Source="app.ico" Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock Text="Replay Buffer" FontSize="24" FontWeight="SemiBold" Margin="12,0,0,2" VerticalAlignment="Center" />
                <TextBlock Text="by Jebula999" Style="{StaticResource RowDesc}" FontSize="13" Margin="10,6,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- status -->
            <Border Style="{StaticResource Group}" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusHalo" Fill="Gray" Opacity="0.18" />
                        <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Idle" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusSub" Style="{StaticResource RowDesc}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ToggleButton" MinWidth="120" Height="34" Margin="0,0,8,0" Click="Toggle_Click" />
                        <Button x:Name="SaveButton" MinWidth="120" Height="34" Style="{DynamicResource AccentButtonStyle}" Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Save clip" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- recording -->
            <TextBlock Text="Recording" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Resolution" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Output size of saved clips" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ComboBox x:Name="ResolutionBox" Grid.Column="2" Style="{StaticResource Field}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE916;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Frame rate" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Match game records every frame the game shows, up to your refresh rate" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ComboBox x:Name="FpsBox" Grid.Column="2" Style="{StaticResource Field}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9E9;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock Text="Rate control" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="RateDesc" Style="{StaticResource RowDesc}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="RateBox" Grid.Column="2" Style="{StaticResource Field}">
                            <ComboBoxItem Content="CBR (constant bitrate)" />
                            <ComboBoxItem Content="VBR (variable bitrate)" />
                            <ComboBoxItem Content="CQP (constant quality)" />
                        </ComboBox>
                    </Grid>
                    <StackPanel x:Name="BitratePanel">
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEC4A;" Style="{StaticResource RowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="BitrateTitle" Text="Bitrate" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Higher looks better in fast motion, but makes bigger files" Style="{StaticResource RowDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="BitrateBox" Grid.Column="2" Style="{StaticResource Field}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="MaxBitratePanel">
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEC4A;" Style="{StaticResource RowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Max bitrate" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="The most it may use in busy scenes" Style="{StaticResource RowDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="MaxBitrateBox" Grid.Column="2" Style="{StaticResource Field}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="CqpPanel">
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8B9;" Style="{StaticResource RowIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CQ level" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Lower is better quality and bigger files. 18-23 suits most games." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="CqpBox" Grid.Column="2" Style="{StaticResource Field}" />
                        </Grid>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEC48;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Encoder preset" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Quality spends a little more GPU encoder time per frame" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ComboBox x:Name="PresetBox" Grid.Column="2" Style="{StaticResource Field}">
                            <ComboBoxItem Content="Speed" />
                            <ComboBoxItem Content="Balanced (default)" />
                            <ComboBoxItem Content="Quality" />
                        </ComboBox>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock Text="Record only the game window" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Keeps notifications, overlays and alt-tabbing out of clips" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox x:Name="WindowOnlyBox" Grid.Column="2" Style="{StaticResource Switch}"
                                  Checked="WindowOnly_Changed" Unchecked="WindowOnly_Changed" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F8;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock Text="Display" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Recorded when no game is running, or with game window recording off" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ComboBox x:Name="MonitorBox" Grid.Column="2" Style="{StaticResource Field}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- replay -->
            <TextBlock Text="Replay" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Clip length" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="How far back a saved clip goes" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ComboBox x:Name="BufferBox" Grid.Column="2" Style="{StaticResource Field}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE964;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock Text="Keep the buffer in" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Memory never touches your drive. Disk uses temp files instead of RAM." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ComboBox x:Name="StorageBox" Grid.Column="2" Style="{StaticResource Field}">
                            <ComboBoxItem Content="Memory (RAM)" />
                            <ComboBoxItem Content="Disk (temp files)" />
                        </ComboBox>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock Text="Estimated size" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="QualityText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,2" />
                            <TextBlock x:Name="EstimateDetail" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="200">
                            <TextBlock x:Name="EstimateClip" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock x:Name="EstimateRam" Style="{StaticResource RowDesc}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE765;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock Text="Save shortcut" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowDesc}" Text="Click the box, then press the keys you want." />
                        </StackPanel>
                        <TextBox x:Name="HotkeyBox" Grid.Column="2" Width="200" VerticalAlignment="Center" IsReadOnly="True" Cursor="Hand"
                                 HorizontalContentAlignment="Center" FontWeight="SemiBold"
                                 GotKeyboardFocus="Hotkey_Focus" LostKeyboardFocus="Hotkey_Blur" PreviewKeyDown="Hotkey_KeyDown" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock Text="Clips folder" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="FolderBox" Style="{StaticResource RowDesc}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open" MinWidth="80" Margin="0,0,8,0" Click="OpenFolder_Click" />
                            <Button Content="Change" MinWidth="80" Click="Folder_Click" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE767;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Save sound" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Plays the moment you press the shortcut" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox x:Name="SoundBox" Grid.Column="2" Style="{StaticResource Switch}" Checked="Sound_Changed" Unchecked="Sound_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- audio -->
            <TextBlock Text="Audio tracks" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowDesc}" Margin="16,14,16,12"
                               Text="Each source is saved as its own track for editing. Clips also start with an &quot;All audio&quot; track that mixes them, so any player hears everything." />
                    <ItemsControl x:Name="TrackList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="56">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource RowIcon}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource RowDesc}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Remove track"
                                                Click="RemoveTrack_Click" Tag="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Divider}" />
                    <WrapPanel Margin="16,12">
                        <Button Margin="0,0,8,0" Click="AddGameTrack_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Game audio" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Click="AddAppTrack_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="App" />
                            </StackPanel>
                        </Button>
                        <Button Click="AddDeviceTrack_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Device" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- games -->
            <TextBlock Text="Games" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE768;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock Text="When to buffer" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Clips are filed in a folder named after the game" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="ModeGames" Content="While a game runs" Checked="Mode_Changed" Margin="0,0,12,0" />
                            <RadioButton x:Name="ModeAlways" Content="Always" Checked="Mode_Changed" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="GameList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="56">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7FC;" Style="{StaticResource RowIcon}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="{Binding Exe}" Style="{StaticResource RowDesc}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Remove game"
                                                Click="RemoveGame_Click" Tag="{Binding Exe}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Divider}" />
                    <WrapPanel Margin="16,12">
                        <Button Margin="0,0,8,0" Click="AddRunningGame_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Running program" />
                            </StackPanel>
                        </Button>
                        <Button Click="BrowseGame_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Browse for .exe" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- general -->
            <TextBlock Text="General" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Opens quietly in the system tray. Closing this window keeps it running there." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox x:Name="StartupBox" Grid.Column="2" Style="{StaticResource Switch}" Checked="Startup_Changed" Unchecked="Startup_Changed" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Expander Margin="16,8" Padding="0">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" Style="{StaticResource RowIcon}" />
                                <TextBlock Text="Activity log" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <TextBox x:Name="LogBox" Height="200" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,8,0,8" />
                    </Expander>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,16,10">
                            <TextBlock x:Name="AboutTitle" Text="Replay Buffer" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Made by Jebula999 · vibe coded with Claude" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="GitHub" MinWidth="80" VerticalAlignment="Center" Click="GitHub_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
